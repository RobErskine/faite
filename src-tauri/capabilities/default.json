{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "window-state:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://myfaite.app/*" },
        { "url": "http://localhost:*/*" }
      ]
    }
  ]
}
