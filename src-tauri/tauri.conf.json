{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "faite-desktop-spike",
  "version": "0.1.0",
  "identifier": "app.myfaite.desktop.spike",
  "build": {
    "frontendDist": "../.next-static",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "NEXT_PUBLIC_AUTH_URL=https://myfaite.app npm run build:static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://myfaite.app wss://myfaite.app http://127.0.0.1:8799; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
