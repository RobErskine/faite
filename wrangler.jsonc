{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faite",
  // Custom entry (not the raw .open-next/worker.js) so the Durable Object class
  // is exported alongside the OpenNext handler. See src/server/worker.ts.
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Custom domain. Cloudflare creates and manages the DNS record itself — do
  // not hand-add an A/CNAME for the apex, or the two will fight.
  //
  // This is the canonical origin: src/server/auth.ts derives `baseURL` from it
  // outside development, and every OAuth callback is registered against it.
  "routes": [{ "pattern": "myfaite.app", "custom_domain": true }],

  // Declaring a route silently turns BOTH of these off by default — wrangler
  // warns about it at the end of a deploy, where it is easy to miss. The old
  // faite.bfmw-dev.workers.dev URL started returning 404 the moment the custom
  // domain landed.
  //
  // `workers_dev` and `preview_urls` are NOT independent, whatever the two
  // separate flags suggest. Preview URLs are only ever served on the
  // workers.dev subdomain ("You cannot currently configure Preview URLs to
  // run on a subdomain other than workers.dev"), so with `workers_dev: false`
  // the subdomain is disabled and every branch preview 404s at the edge —
  // silently, with `previews_enabled: true` still reported by the API. This
  // was `false` for P0-P4 and branch previews consequently never worked once;
  // it read as "the build is broken" rather than as a config interaction.
  //
  // Turning it on costs a second live URL for production
  // (faite.bfmw-dev.workers.dev). The old objection to that — "myfaite.app is
  // the only origin auth works on" — is stale: `createAuth(env, request)`
  // derives its baseURL from the request origin, so email/password auth works
  // on any origin. GitHub OAuth still won't, because a GitHub OAuth App
  // accepts exactly one callback URL and it points at production. Sign in
  // with email/password when testing a preview.
  //
  // NOTE: this file overrides the dashboard on every deploy. Toggling
  // "Worker URL" in the Cloudflare UI works until the next push, then wrangler
  // resets it to whatever is written here.
  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Resolves the `open-next/worker` specifier used by src/server/worker.ts to the
  // generated bundle. TypeScript resolves the same specifier via the matching
  // paths entry in tsconfig.worker.json.
  "alias": {
    "open-next/worker": "./.open-next/worker.js"
  },

  "observability": {
    "enabled": true
  },

  // Where inbound mail for EI-186 arrives. A SUBDOMAIN, not the apex: Email
  // Routing is zone-level and claims the apex MX by default, and the apex is
  // wanted for a real `rob@myfaite.app` later. Cloudflare supports unlocking
  // the root-domain MX/SPF/DKIM to point at another provider while a
  // configured subdomain keeps routing here (limit: 30 domains per zone).
  //
  // **Receiving needs nothing else in this file.** The catch-all rule that
  // sends `*@in.myfaite.app` to this Worker is ZONE CONFIGURATION — set in the
  // dashboard or the Email Routing REST API — not a binding. This var only
  // tells the Worker which domain to accept, so a message delivered to some
  // other hostname is rejected rather than silently resolved.
  "vars": {
    "EMAIL_INGEST_DOMAIN": "in.myfaite.app"
  },

  // Per-IP abuse guard for POST /api/contact (EI-206). Turnstile stops bots,
  // not a determined human retrying by hand. `namespace_id` is an arbitrary
  // string unique within this Worker, not something to provision elsewhere —
  // the binding itself is what creates the rate limiter. `period` is capped
  // at 10 or 60 seconds by the platform; 60s/3 requests is a real ceiling for
  // a contact form without being so tight a legitimate retry after a typo
  // trips it.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  // Per-user Durable Object: authoritative user data + sync coordinator (plan P3).
  // Declared at P0 so the custom worker entry and migrations exist before sync lands.
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDurableObject"
      }
    ]
  },

  // SQLite-backed DO storage. Confirmed available on this account.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDurableObject"]
    }
  ],

  // Auth/global tables only (user, session, account, verification). Todo data
  // stays in the per-user DO. See src/server/auth.ts.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "faite-auth",
      "database_id": "d0be89ae-e45d-44f4-804f-7f88a2f169fa",
      // Points `wrangler d1 migrations *` at drizzle-kit's own output dir
      // instead of the wrangler default (./migrations), so there's one
      // migration directory, not two. See EI-79 / docs/AUTH.md.
      "migrations_dir": "./drizzle/auth"
    }
  ],

  // Transactional email (verification, password reset) via Cloudflare Email
  // Service. Restricted to one sender so a compromised binding can't spoof other
  // addresses. Sending is inert until `myfaite.app` DNS is on Cloudflare and
  // `wrangler email sending enable myfaite.app` has run — see src/server/email.ts.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@myfaite.app"]
    }
  ]

  // Routes for myfaite.app are added once its DNS is on this Cloudflare account.
  // Until then the app is reachable only at the workers.dev URL.
}
