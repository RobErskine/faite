{
  "name": "faite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agentation": "agentation-mcp server",
    "dev": "NEXT_PUBLIC_AGENTATION=1 NEXT_PUBLIC_AUTH_URL=http://localhost:8787 concurrently -k -n agentation,next -c magenta,cyan \"npm:agentation\" \"next dev\"",
    "build": "next build",
    "build:static": "BUILD_TARGET=static next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:static",
    "preview": "NEXT_PUBLIC_AGENTATION=1 opennextjs-cloudflare build && concurrently -k -n agentation,preview -c magenta,cyan \"npm:agentation\" \"opennextjs-cloudflare preview\"",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "auth:schema": "better-auth generate --config src/server/auth-cli.ts --output src/server/auth-schema.ts --yes && drizzle-kit generate",
    "schema:generate": "drizzle-kit generate --config=drizzle.user-do.config.ts",
    "schema:check": "vitest run src/server/db src/server/sync/columns.test.ts",
    "schema:snapshot": "vitest run src/server/db/schema-parity.test.ts -u",
    "schema:info": "node scripts/schema/info.mjs",
    "schema:reset": "node scripts/schema/reset.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@blocknote/core": "^0.53.0",
    "@blocknote/react": "^0.53.0",
    "@blocknote/shadcn": "^0.53.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hotkeys-hook": "^5.3.3",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  }
}
