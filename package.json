{
  "name": "faite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agentation": "agentation-mcp server",
    "dev": "NEXT_PUBLIC_AGENTATION=1 NEXT_PUBLIC_AUTH_URL=http://localhost:8787 NEXT_PUBLIC_APP_ENV=development NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEW0aou3ZhT4nDu3 concurrently -k -n agentation,next -c magenta,cyan \"npm:agentation\" \"next dev\"",
    "build": "next build",
    "build:static": "BUILD_TARGET=static NEXT_PUBLIC_APP_SHELL=1 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --project=desktop --project=phone-iphone",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:static",
    "preview": "NEXT_PUBLIC_AGENTATION=1 NEXT_PUBLIC_APP_ENV=development NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEW0aou3ZhT4nDu3 opennextjs-cloudflare build && concurrently -k -n agentation,preview -c magenta,cyan \"npm:agentation\" \"opennextjs-cloudflare preview\"",
    "dev:full": "NEXT_PUBLIC_AGENTATION=1 NEXT_PUBLIC_AUTH_URL=http://localhost:8787 NEXT_PUBLIC_APP_ENV=development NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEW0aou3ZhT4nDu3 opennextjs-cloudflare build && NEXT_PUBLIC_AGENTATION=1 NEXT_PUBLIC_AUTH_URL=http://localhost:8787 NEXT_PUBLIC_APP_ENV=development NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEW0aou3ZhT4nDu3 concurrently -k -n agentation,preview,next -c magenta,cyan,green \"npm:agentation\" \"opennextjs-cloudflare preview\" \"next dev\"",
    "deploy": "NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEW0aou3ZhT4nDu3 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "auth:schema": "better-auth generate --config src/server/auth-cli.ts --output src/server/auth-schema.ts --yes && drizzle-kit generate",
    "dev:bootstrap": "node scripts/dev-bootstrap.mjs",
    "auth:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "auth:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote",
    "deploy:with-migrations": "npm run auth:migrate:remote && npm run deploy",
    "schema:generate": "drizzle-kit generate --config=drizzle.user-do.config.ts",
    "schema:check": "vitest run src/server/db src/server/sync/columns.test.ts",
    "schema:snapshot": "vitest run src/server/db/schema-parity.test.ts -u",
    "schema:info": "node scripts/schema/info.mjs",
    "schema:reset": "node scripts/schema/reset.mjs",
    "openapi:generate": "vite-node -c vitest.config.ts scripts/openapi/generate.ts",
    "icons": "node scripts/icons/generate.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:install": "node scripts/desktop-install.mjs",
    "desktop:bundle": "node scripts/desktop/bundle-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/api-key": "^1.6.29",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@blocknote/core": "^0.53.0",
    "@blocknote/react": "^0.53.0",
    "@blocknote/shadcn": "^0.53.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@scalar/api-reference-react": "^0.9.65",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "agents": "^0.21.0",
    "better-auth": "^1.6.29",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.33.0",
    "next": "16.2.12",
    "postal-mime": "^3.0.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hotkeys-hook": "^5.3.3",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.62.1",
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0",
    "zod-openapi": "^6.0.1"
  }
}
