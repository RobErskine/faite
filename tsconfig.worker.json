{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["esnext"],
    "noEmit": true,
    // The custom worker entry imports .open-next/worker.js, which only exists
    // after a build. Allow it to resolve without a type declaration.
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"],
      // Resolved to the real bundle at build time by the alias below; typed via
      // src/server/open-next.d.ts so a clean checkout typechecks.
      "open-next/worker": ["./src/server/open-next.d.ts"]
    }
  },
  "include": ["src/server/**/*.ts"],
  "exclude": ["node_modules"]
}
