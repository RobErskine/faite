{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["esnext"],
    "noEmit": true,
    // The custom worker entry imports .open-next/worker.js, which only exists
    // after a build. Allow it to resolve without a type declaration.
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"],
      // Resolved to the real bundle at build time by the alias below; typed via
      // src/server/open-next.d.ts so a clean checkout typechecks.
      "open-next/worker": ["./src/server/open-next.d.ts"]
    }
  },
  // scripts/openapi lives here rather than under the root tsconfig — see
  // that file's exclude comment. It needs the same CloudflareEnv-aware
  // program `src/server` gets, since `generate.ts` imports `auth-cli.ts`.
  "include": ["src/server/**/*.ts", "scripts/openapi/**/*.ts", "cloudflare-env.d.ts"],
  // `migration-21-backfill.test.ts` runs a migration's real SQL against
  // `node:sqlite`, which only exists in Node — this program is typed against
  // `@cloudflare/workers-types` alone, so the import cannot resolve here. It
  // lives under `src/server/` because that is where the migration lives, not
  // because the Worker ever runs it; vitest types and runs it under the root
  // config. Excluding it is what keeps `types` honest: adding Node types to
  // the Worker program to satisfy one test would let every Worker file reach
  // for APIs that are not there at runtime.
  "exclude": ["node_modules", "src/server/db/migration-21-backfill.test.ts"]
}
