{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // src/server is Workers-runtime code (Durable Object + custom worker entry).
  // It uses `cloudflare:workers` and imports the generated .open-next bundle, so it
  // is typechecked by tsconfig.worker.json rather than by the Next.js build.
  //
  // cloudflare-env.d.ts (wrangler-generated) is excluded for the same reason:
  // its `mainModule` field is `typeof import("./src/server/worker")`, which
  // would otherwise drag worker.ts — and its Workers-only `open-next/worker`
  // import — into this program too. Nothing in the Next app layer touches
  // CloudflareEnv; only tsconfig.worker.json needs it.
  "exclude": [
    "node_modules",
    "src/server",
    ".open-next",
    ".next-static",
    "cloudflare-env.d.ts"
  ]
}
